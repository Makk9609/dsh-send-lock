{
  "name": "dsh-send-lock",
  "version": "0.2.1",
  "description": "Changes Enter to insert a newline in DSH Web. Use Cmd/Ctrl+Enter to send messages.",
  "type": "module",
  "license": "MIT",
  "author": "MaiZhe'ning",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makk9609/dsh-send-lock.git"
  },
  "homepage": "https://github.com/Makk9609/dsh-send-lock",
  "bugs": {
    "url": "https://github.com/Makk9609/dsh-send-lock/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "composer",
    "enter",
    "send"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
